# Self-check (stamped on self_check_report.json)
SELF_CHECK_KEY=

# --- LLM -------------------------------------------------------------------
# Provider: groq | google | anthropic | openai. Change these two lines to switch.
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash-lite
# Used automatically when the main provider fails (leave empty to disable).
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
# Cheaper model for small jobs (claim judge, edit planner). Must belong to LLM_PROVIDER. Empty = use LLM_MODEL.
LLM_FAST_MODEL=
# Independent judge used only by the evals (provider:model).
EVAL_JUDGE=groq:qwen/qwen3.8-27b

GROQ_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- LangSmith -------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=researchpilot-yourname
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Chunking --------------------------------------------------------------
# recursive | fixed | markdown
CHUNKING_STRATEGY=recursive
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Embeddings ------------------------------------------------------------
# fastembed:<model> (local, no key) | hash (no model) | openai:<model>
EMBEDDING_MODEL=fastembed:BAAI/bge-small-en-v1.5

# --- Retrieval -------------------------------------------------------------
TOP_K=4
# dense | bm25 | hybrid
RETRIEVAL_MODE=hybrid
# chunks less similar than this are ignored, so off-topic questions get "I couldn't find that"
MIN_SCORE=0.5

# --- Research agent --------------------------------------------------------
# tavily | firecrawl | ddgs | wikipedia  (the others are used as backups when the first one fails)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
RESEARCH_MAX_SECTIONS=5
RESEARCH_SOURCES_PER_SECTION=4
RESEARCH_PARALLEL_SECTIONS=4
# false = skip the claim verification step (used as the v1 baseline in evals)
RESEARCH_VERIFY=true


# --- Accounts and e-mail (Brevo) -------------------------------------------
# true = an account is needed for everything except the welcome page
AUTH_ENABLED=false
# Without a key the confirmation code is printed in the server log instead of being e-mailed.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ResearchPilot
SESSION_TTL_DAYS=14
