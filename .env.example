# Copy to .env (never commit .env):  cp .env.example .env

# --- Self-check -----------------------------------------------------------
# Your trainee ID, given by your trainer. Stamped on self_check_report.json.
SELF_CHECK_KEY=trainee-your-name

# --- LLM (milestone 1) -----------------------------------------------------
# anthropic -> uv add langchain-anthropic   |   openai -> uv add langchain-openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- LangSmith observability (milestone 2) ---------------------------------
# Create a key at https://smith.langchain.com -> Settings -> API Keys.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-chatbot-your-name
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Chunking (milestone 3) ------------------------------------------------
# Name of a strategy you registered in app/vectordb/chunking.py
CHUNKING_STRATEGY=fixed
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Embeddings (milestone 4) ----------------------------------------------
EMBEDDING_MODEL=

# --- Retrieval (milestone 7) -----------------------------------------------
TOP_K=4
# MIN_SCORE=0.3   # drop chunks scoring below this (0 = off); tune for your embedding model

# --- Data folders (optional; defaults are under ./data) ---------------------
# DATA_DIR=./data
# SESSIONS_DIR=./data/sessions
# DOCUMENTS_DIR=./data/documents
# VECTOR_DIR=./data/vectorstore

# --- Advanced chat features (all optional; defaults shown) -----------------
# SMART_ROUTING=true        # classify messages; skip retrieval for "hi", "what did I ask earlier?", etc.
# ALWAYS_RETRIEVE=false     # true = retrieve on EVERY turn (disables the retrieval-skipping routes)
# GUARDRAILS=true           # input validation, prompt-injection + unsafe-request blocking
# GROUNDING_MODE=enforce    # off | warn | enforce  — check answers are supported by retrieved text
# HITL_ENABLED=true         # pause for human approval before dangerous tools (delete_document)
# MEMORY_MAX_MESSAGES=10    # recent messages sent verbatim; older ones are summarised
# MEMORY_SUMMARIZE=true     # summarise older messages with the LLM (one cached extra call)
